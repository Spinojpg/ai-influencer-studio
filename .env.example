# Kopiraj ovaj fajl u data/.env i upisi svoje vrijednosti.
# Nakon instalacije to je %LOCALAPPDATA%\AIInfluencerStudio\data\.env
# Nikad ne dijelite .env i ne commitajte ga.

# xAI Grok — obavezno za karticu Poruke
# Kljuc dobivas na https://console.x.ai (placanje po potrosnji).
XAI_API_KEY=
# Zadani model; u postavkama Studija mozes promijeniti.
XAI_MODEL=grok-4
# Ostavi ovako, osim ako koristis drugi endpoint (npr. test).
# XAI_API_BASE=https://api.x.ai/v1

# Instagram Messaging (Graph API) — opcionalno
# Treba Business/Creator racun spojen na Facebook Page i Meta developer app.
# Webhook URL: https://TVOJ-TUNEL/webhook/instagram
# (lokalni Studio slusa na http://127.0.0.1:7860; koristi cloudflared ili ngrok za HTTPS)
IG_VERIFY_TOKEN=
IG_APP_SECRET=
IG_ACCESS_TOKEN=
# IG_ACCOUNT_ID=
# GRAPH_API_VERSION=v22.0

# Telegram bot — opcionalno (long polling, bez tunela)
# Napravi bota preko @BotFather i zalijepi token.
TELEGRAM_BOT_TOKEN=

# Studio
# STUDIO_HOST=127.0.0.1
# STUDIO_PORT=7860
# STUDIO_NO_BROWSER=1

# GitHub token za auto-update s privatnog repozitorija
# Spinojpg/ai-influencer-studio. Koraci: TOKEN_UPUTE.txt
# Fine-grained token, samo taj repo, Contents: Read-only.
# Spremi ovdje, nikad se ne ispisuje u logove.
GITHUB_TOKEN=
